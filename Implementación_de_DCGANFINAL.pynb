  "cells": [
    {
      "cell_type": "code",
      "execution_count": 1,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "0YEc3R8Yrpe5",
        "outputId": "362c015b-a575-4e8d-dc97-b3e2893a7c03"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Dispositivo en uso: cuda\n"
          ]
        }
      ],
      "source": [
        "# CELDA 1: Importación de librerías y configuración de dispositivo\n",
        "import os\n",
        "import torch\n",
        "import torch.nn as nn\n",
        "import torch.optim as optim\n",
        "from torch.utils.data import DataLoader, TensorDataset\n",
        "import torchvision.utils as vutils\n",
        "import torchvision.transforms as transforms\n",
        "from sklearn.datasets import fetch_lfw_people\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
        "print(f\"Dispositivo en uso: {device}\")\n",
        "\n",
        "# Hiperparámetros clave\n",
        "BATCH_SIZE = 64\n",
        "IMAGE_SIZE = 64\n",
        "CHANNELS = 3\n",
        "LATENT_DIM = 100   # Dimensión del vector de ruido z\n",
        "GEN_FEATURES = 64\n",
        "DISC_FEATURES = 64\n",
        "LR = 0.0002\n",
        "BETA1 = 0.5        # Recomendado por el paper de DCGAN\n",
        "EPOCHS = 30        # Aumentar a 80-100 para mayor nitidez"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# CELDA 2: Preparación de datos (Rostros humanos LFW redimensionados a 64x64)\n",
        "print(\"Descargando y preparando dataset de rostros LFW...\")\n",
        "lfw = fetch_lfw_people(min_faces_per_person=5, resize=0.5, color=True)\n",
        "images = lfw.images  # Shape: (N, H, W, 3) en rango [0, 1]\n",
        "\n",
        "# Transformar a tensores de PyTorch, redimensionar a 64x64 y normalizar a [-1, 1]\n",
        "transform = transforms.Compose([\n",
        "    transforms.ToPILImage(),\n",
        "    transforms.Resize((IMAGE_SIZE, IMAGE_SIZE)),\n",
        "    transforms.ToTensor(),\n",
        "    transforms.Normalize((0.5, 0.5, 0.5), (0.5, 0.5, 0.5))\n",
        "])\n",
        "\n",
        "tensor_images = torch.stack([transform((img * 255).astype(np.uint8)) for img in images])\n",
        "dataset = TensorDataset(tensor_images)\n",
        "dataloader = DataLoader(dataset, batch_size=BATCH_SIZE, shuffle=True)\n",
        "\n",
        "print(f\"Total de imágenes cargadas: {len(tensor_images)} | Forma de batch: {next(iter(dataloader))[0].shape}\")\n",
        "\n",
        "# Visualizar muestras reales\n",
        "real_batch = next(iter(dataloader))[0][:16]\n",
        "plt.figure(figsize=(6, 6))\n",
        "plt.axis(\"off\")\n",
        "plt.title(\"Imágenes Reales de Entrenamiento\")\n",
        "plt.imshow(np.transpose(vutils.make_grid(real_batch, nrow=4, padding=2, normalize=True), (1, 2, 0)))\n",
        "plt.show()"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 558
        },
        "id": "gUVqRBmgr7I3",
        "outputId": "b4caeb06-8809-47a0-e773-e68a38e3c478"
      },
      "execution_count": 2,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Descargando y preparando dataset de rostros LFW...\n",
            "Total de imágenes cargadas: 5985 | Forma de batch: torch.Size([64, 3, 64, 64])\n"
          ]
        },
        {
          "output_type": "display_data",
          "data": {
            "text/plain": [
              "<Figure size 600x600 with 1 Axes>"
            ],
            "image/png": "\n"
          },
          "metadata": {}
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# CELDA 3: Definición de Arquitectura DCGAN (Generator y Discriminator)\n",
        "def weights_init(m):\n",
        "    classname = m.__class__.__name__\n",
        "    if classname.find('Conv') != -1:\n",
        "        nn.init.normal_(m.weight.data, 0.0, 0.02)\n",
        "    elif classname.find('BatchNorm') != -1:\n",
        "        nn.init.normal_(m.weight.data, 1.0, 0.02)\n",
        "        nn.init.constant_(m.bias.data, 0)\n",
        "\n",
        "class Generator(nn.Module):\n",
        "    def __init__(self):\n",
        "        super(Generator, self).__init__()\n",
        "        self.net = nn.Sequential(\n",
        "            # Entrada: Z (LATENT_DIM x 1 x 1) -> (GEN_FEATURES*8 x 4 x 4)\n",
        "            nn.ConvTranspose2d(LATENT_DIM, GEN_FEATURES * 8, 4, 1, 0, bias=False),\n",
        "            nn.BatchNorm2d(GEN_FEATURES * 8),\n",
        "            nn.ReLU(True),\n",
        "            # Estado: (GEN_FEATURES*4 x 8 x 8)\n",
        "            nn.ConvTranspose2d(GEN_FEATURES * 8, GEN_FEATURES * 4, 4, 2, 1, bias=False),\n",
        "            nn.BatchNorm2d(GEN_FEATURES * 4),\n",
        "            nn.ReLU(True),\n",
        "            # Estado: (GEN_FEATURES*2 x 16 x 16)\n",
        "            nn.ConvTranspose2d(GEN_FEATURES * 4, GEN_FEATURES * 2, 4, 2, 1, bias=False),\n",
        "            nn.BatchNorm2d(GEN_FEATURES * 2),\n",
        "            nn.ReLU(True),\n",
        "            # Estado: (GEN_FEATURES x 32 x 32)\n",
        "            nn.ConvTranspose2d(GEN_FEATURES * 2, GEN_FEATURES, 4, 2, 1, bias=False),\n",
        "            nn.BatchNorm2d(GEN_FEATURES),\n",
        "            nn.ReLU(True),\n",
        "            # Salida: (CHANNELS x 64 x 64)\n",
        "            nn.ConvTranspose2d(GEN_FEATURES, CHANNELS, 4, 2, 1, bias=False),\n",
        "            nn.Tanh()\n",
        "        )\n",
        "\n",
        "    def forward(self, z):\n",
        "        return self.net(z)\n",
        "\n",
        "class Discriminator(nn.Module):\n",
        "    def __init__(self):\n",
        "        super(Discriminator, self).__init__()\n",
        "        self.net = nn.Sequential(\n",
        "            # Entrada: (3 x 64 x 64) -> (DISC_FEATURES x 32 x 32)\n",
        "            nn.Conv2d(CHANNELS, DISC_FEATURES, 4, 2, 1, bias=False),\n",
        "            nn.LeakyReLU(0.2, inplace=True),\n",
        "            # Estado: (DISC_FEATURES*2 x 16 x 16)\n",
        "            nn.Conv2d(DISC_FEATURES, DISC_FEATURES * 2, 4, 2, 1, bias=False),\n",
        "            nn.BatchNorm2d(DISC_FEATURES * 2),\n",
        "            nn.LeakyReLU(0.2, inplace=True),\n",
        "            # Estado: (DISC_FEATURES*4 x 8 x 8)\n",
        "            nn.Conv2d(DISC_FEATURES * 2, DISC_FEATURES * 4, 4, 2, 1, bias=False),\n",
        "            nn.BatchNorm2d(DISC_FEATURES * 4),\n",
        "            nn.LeakyReLU(0.2, inplace=True),\n",
        "            # Estado: (DISC_FEATURES*8 x 4 x 4)\n",
        "            nn.Conv2d(DISC_FEATURES * 4, DISC_FEATURES * 8, 4, 2, 1, bias=False),\n",
        "            nn.BatchNorm2d(DISC_FEATURES * 8),\n",
        "            nn.LeakyReLU(0.2, inplace=True),\n",
        "            # Salida: probabilidad escalar (1 x 1 x 1)\n",
        "            nn.Conv2d(DISC_FEATURES * 8, 1, 4, 1, 0, bias=False),\n",
        "            nn.Sigmoid()\n",
        "        )\n",
        "\n",
        "    def forward(self, img):\n",
        "        return self.net(img).view(-1, 1).squeeze(1)\n",
        "\n",
        "netG = Generator().to(device)\n",
        "netD = Discriminator().to(device)\n",
        "netG.apply(weights_init)\n",
        "netD.apply(weights_init)\n",
        "print(\"Modelos Generator y Discriminator inicializados.\")"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "Z3mHhJ6dr-VH",
        "outputId": "a4e5cc1c-f667-4448-ff0d-07aeafa8cda2"
      },
      "execution_count": 3,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Modelos Generator y Discriminator inicializados.\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# CELDA 4: Entrenamiento Adversarial\n",
        "criterion = nn.BCELoss()\n",
        "fixed_noise = torch.randn(16, LATENT_DIM, 1, 1, device=device)\n",
        "\n",
        "optimizerD = optim.Adam(netD.parameters(), lr=LR, betas=(BETA1, 0.999))\n",
        "optimizerG = optim.Adam(netG.parameters(), lr=LR, betas=(BETA1, 0.999))\n",
        "\n",
        "G_losses, D_losses = [], []\n",
        "\n",
        "for epoch in range(EPOCHS):\n",
        "    for i, (real_imgs,) in enumerate(dataloader):\n",
        "        real_imgs = real_imgs.to(device)\n",
        "        b_size = real_imgs.size(0)\n",
        "\n",
        "        # --- (1) Actualizar Discriminador: maximizar log(D(x)) + log(1 - D(G(z))) ---\n",
        "        netD.zero_grad()\n",
        "        label_real = torch.full((b_size,), 0.9, dtype=torch.float, device=device) # Label smoothing\n",
        "        output_real = netD(real_imgs)\n",
        "        errD_real = criterion(output_real, label_real)\n",
        "        errD_real.backward()\n",
        "\n",
        "        noise = torch.randn(b_size, LATENT_DIM, 1, 1, device=device)\n",
        "        fake_imgs = netG(noise)\n",
        "        label_fake = torch.full((b_size,), 0.0, dtype=torch.float, device=device)\n",
        "        output_fake = netD(fake_imgs.detach())\n",
        "        errD_fake = criterion(output_fake, label_fake)\n",
        "        errD_fake.backward()\n",
        "\n",
        "        errD = errD_real + errD_fake\n",
        "        optimizerD.step()\n",
        "\n",
        "        # --- (2) Actualizar Generador: maximizar log(D(G(z))) ---\n",
        "        netG.zero_grad()\n",
        "        output_gen = netD(fake_imgs)\n",
        "        errG = criterion(output_gen, torch.ones_like(output_gen))\n",
        "        errG.backward()\n",
        "        optimizerG.step()\n",
        "\n",
        "        G_losses.append(errG.item())\n",
        "        D_losses.append(errD.item())\n",
        "\n",
        "    if (epoch + 1) % 5 == 0 or epoch == 0:\n",
        "        print(f\"Época [{epoch+1}/{EPOCHS}] | Loss_D: {errD.item():.4f} | Loss_G: {errG.item():.4f}\")"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "wUxkQ0sCsMkt",
        "outputId": "a8653e99-bf2a-406f-edfb-34ff85621a2e"
      },
      "execution_count": 4,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Época [1/30] | Loss_D: 0.8418 | Loss_G: 7.5967\n",
            "Época [5/30] | Loss_D: 1.1151 | Loss_G: 4.1829\n",
            "Época [10/30] | Loss_D: 1.5437 | Loss_G: 1.9532\n",
            "Época [15/30] | Loss_D: 0.8674 | Loss_G: 3.5267\n",
            "Época [20/30] | Loss_D: 0.7102 | Loss_G: 3.3607\n",
            "Época [25/30] | Loss_D: 0.5907 | Loss_G: 3.2553\n",
            "Época [30/30] | Loss_D: 1.1788 | Loss_G: 1.4218\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# CELDA 5: Evaluación de Resultados (Curvas de pérdida e imágenes generadas)\n",
        "plt.figure(figsize=(10, 4))\n",
        "plt.title(\"Pérdidas del Generador y Discriminador durante el entrenamiento\")\n",
        "plt.plot(G_losses, label=\"Generator (G)\", alpha=0.8)\n",
        "plt.plot(D_losses, label=\"Discriminator (D)\", alpha=0.8)\n",
        "plt.xlabel(\"Iteraciones\")\n",
        "plt.ylabel(\"BCE Loss\")\n",
        "plt.legend()\n",
        "plt.show()\n",
        "\n",
        "with torch.no_grad():\n",
        "    fake_samples = netG(fixed_noise).detach().cpu()\n",
        "\n",
        "plt.figure(figsize=(6, 6))\n",
        "plt.axis(\"off\")\n",
        "plt.title(\"Rostros Sintéticos Generados por DCGAN\")\n",
        "plt.imshow(np.transpose(vutils.make_grid(fake_samples, nrow=4, padding=2, normalize=True), (1, 2, 0)))\n",
        "plt.show()"
      ],
      "metadata": {
        "id": "_oraGaXCsUqg",
